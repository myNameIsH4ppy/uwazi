# Uwazi Environment Configuration for Development
DBHOST=mongo
REDIS_HOST=redis
ELASTICSEARCH_URL=http://elasticsearch:9200
DATABASE_NAME=development_db
INDEX_NAME=development_db
NODE_ENV=development
FILES_ROOT_PATH=/uwazi

# Volumes to be mounted
UPLOADED_DOCUMENTS=./uploaded_documents
CUSTOM_UPLOADS=./custom_uploads
TEMPORAL_FILES=./temporal_files
LOG=./log
MONGO_DUMP_PATH=./mongo_backup
ES_BACKUP_PATH=./es_backup