# Uwazi Environment Configuration for Production
DBHOST=mongo
REDIS_HOST=redis
ELASTICSEARCH_URL=http://elasticsearch:9200
DATABASE_NAME=production_db
INDEX_NAME=production_db
NODE_ENV=production
FILES_ROOT_PATH=/uwazi

# Volumes to be mounted
UPLOADED_DOCUMENTS=../uploaded_documents
CUSTOM_UPLOADS=../custom_uploads
TEMPORAL_FILES=../temporal_files
LOG=../log
MONGO_DUMP_PATH=../mongo_backup
ES_BACKUP_PATH=../es_backup